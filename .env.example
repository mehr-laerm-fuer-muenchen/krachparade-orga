# Kopie dieser Datei als .env.local anlegen und die Werte eintragen.
# .env.local wird nie zu GitHub hochgeladen (siehe .gitignore).
# Hier stehen nur Namen, nie Werte.

DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=

# Nur auf dem Server (Coolify): "production" oder "preview". Lokal leer lassen.
# Mit APP_ENV=preview und ENABLE_DEV_LOGIN=1 gibt es den Dev-Login (/dev/login).
APP_ENV=
ENABLE_DEV_LOGIN=

# Spec 032: Bestätigungs-Mail per SMTP. Fehlt eine Variable, wird nichts verschickt.
# Bei APP_ENV=preview nur mit MAIL_ENABLED=1.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_ENABLED=

# Cloudflare Turnstile (Bot-Prüfung auf /anmeldung). Lokal und in den Klicktests leer
# lassen (dann aus). Bei APP_ENV=production Pflicht, sonst nimmt /anmeldung nichts an.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
