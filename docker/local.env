# Values for the local Docker database (docker/compose.yaml). Made up and
# only valid on this machine – no real secrets belong here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/main
LOCAL_NEON_HTTP_ENDPOINT=http://localhost:4444/sql
AUTH_SECRET=local-docker-only-not-a-real-secret-0000000000000000
AUTH_GOOGLE_ID=local-docker-only
AUTH_GOOGLE_SECRET=local-docker-only
ADMIN_EMAILS=
# Spec 032: mails go to Mailpit (http://localhost:8026), never outside.
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM="Krachparade Orga <orga@example.org>"
