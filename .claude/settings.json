{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./src/**)",
      "Read(./docs/**)",
      "Read(./e2e/**)",
      "Read(./package.json)",
      "Read(./tsconfig.json)",
      "Read(./drizzle.config.ts)",
      "Read(./.env.example)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git branch)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat package.json)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(git branch --show-current)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(VERCEL_ENV=preview ENABLE_DEV_LOGIN=1 pnpm build)",
      "Bash(AUTH_TRUST_HOST=1 VERCEL_ENV=preview ENABLE_DEV_LOGIN=1 pnpm start -p 3100)",
      "Bash(AUTH_TRUST_HOST=true VERCEL_ENV=preview ENABLE_DEV_LOGIN=1 pnpm start -p 3100)",
      "Bash(BASE_URL=http://localhost:3100 pnpm e2e *)",
      "Bash(git show *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(lsof -i :3000)",
      "Bash(lsof -i :3100)",
      "Edit(/src/**)",
      "Edit(/e2e/**)",
      "Edit(/docs/specs/**)"
    ],
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/agents/**)",
      "Edit(/scripts/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/package.json)",
      "Edit(/pnpm-lock.yaml)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/tsconfig.json)",
      "Edit(/.node-version)",
      "Edit(/.gitignore)",
      "Edit(/next.config.ts)",
      "Edit(/drizzle.config.ts)",
      "Edit(/drizzle.prod.config.ts)",
      "Edit(/vitest.config.ts)",
      "Edit(/playwright.config.ts)",
      "Edit(/eslint.config.mjs)",
      "Edit(/src/proxy.ts)",
      "Edit(/src/app/dev/**)",
      "Edit(/src/auth.ts)",
      "Edit(/src/app/api/auth/**)",
      "Edit(/src/app/login/**)",
      "Edit(/src/actions/auth.ts)",
      "Edit(/src/lib/dev-login.ts)",
      "Edit(/src/lib/dev-login.test.ts)",
      "Edit(/src/lib/access.ts)",
      "Edit(/src/lib/access.test.ts)",
      "Edit(/src/lib/env.ts)",
      "Edit(/src/db/index.ts)",
      "Edit(/src/components/current-member.ts)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm drizzle-kit push:*)",
      "Bash(pnpm exec drizzle-kit push:*)",
      "Bash(git checkout:*)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:reset:dev)",
      "Bash(pnpm db:push)",
      "Bash(git switch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm db:push:prod)",
      "Bash(pnpm db:push:prod:*)",
      "Bash(pnpm db:seed:prod)",
      "Bash(pnpm db:seed:prod:*)",
      "Bash(pnpm drizzle-kit drop:*)",
      "Bash(pnpm exec drizzle-kit drop:*)",
      "Bash(psql:*)",
      "Bash(cat .env:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)",
      "Bash(sed -i*)",
      "Bash(sed --in-place*)",
      "Bash(perl -i*)",
      "Bash(perl -pi*)",
      "Bash(perl -p -i*)"
    ]
  }
}
