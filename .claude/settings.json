{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./src/**)",
      "Read(./docs/**)",
      "Read(./e2e/**)",
      "Read(./package.json)",
      "Read(./tsconfig.json)",
      "Read(./drizzle.config.ts)",
      "Read(./.env.example)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git branch)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat package.json)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(git branch --show-current)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(VERCEL_ENV=preview ENABLE_DEV_LOGIN=1 pnpm build)",
      "Bash(AUTH_TRUST_HOST=1 VERCEL_ENV=preview ENABLE_DEV_LOGIN=1 pnpm start -p 3100)",
      "Bash(AUTH_TRUST_HOST=true VERCEL_ENV=preview ENABLE_DEV_LOGIN=1 pnpm start -p 3100)",
      "Bash(BASE_URL=http://localhost:3100 pnpm e2e *)",
      "Bash(git show *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(lsof -i :3000)",
      "Bash(lsof -i :3100)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(pnpm add:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm drizzle-kit push:*)",
      "Bash(pnpm exec drizzle-kit push:*)",
      "Bash(git checkout:*)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:reset:dev)",
      "Bash(pnpm db:push)",
      "Bash(git switch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm db:push:prod)",
      "Bash(pnpm db:push:prod:*)",
      "Bash(pnpm db:seed:prod)",
      "Bash(pnpm db:seed:prod:*)",
      "Bash(pnpm drizzle-kit drop:*)",
      "Bash(pnpm exec drizzle-kit drop:*)",
      "Bash(psql:*)",
      "Bash(cat .env:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)"
    ]
  }
}
